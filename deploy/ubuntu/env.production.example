# /etc/teamsync/teamsync.env
# Read by systemd. Keep this file root:teamsync 0640.

TEAMSYNC_DATA_DIR=/var/lib/teamsync
TEAMSYNC_BIND_HOST=127.0.0.1
TEAMSYNC_PORT=8000
TEAMSYNC_COOKIE_SECURE=true
TEAMSYNC_LOG_LEVEL=INFO

# First admin password. Used only while the users table is empty. If unset, a
# password is generated and written to /var/lib/teamsync/initial-admin-password.txt.
#TEAMSYNC_ADMIN_PASSWORD=change-me-before-first-start

# Optional: a directory on this server to scan on a timer (normally unused; the
# workstation push script is the usual path).
#TEAMSYNC_WATCH_DIR=/srv/teamsync-inbox
#TEAMSYNC_SYNC_INTERVAL_SECONDS=900
